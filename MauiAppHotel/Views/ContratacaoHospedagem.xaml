<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop
                Color="{StaticResource HotelBackground}"
                Offset="0.0" />

            <GradientStop
                Color="{StaticResource HotelBackground2}"
                Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="20"
            MaximumWidthRequest="520"
            HorizontalOptions="Center">

            <!-- Cabeçalho -->
            <VerticalStackLayout
                Spacing="4"
                Margin="0,20,0,10">

                <Label
                    Text="Reserva de Hospedagem"
                    Style="{StaticResource TituloPrincipal}" />

                <Label
                    Text="Calcule o valor da sua estadia"
                    FontFamily="OpenSansRegular"
                    FontSize="15"
                    TextColor="#BAE6FD"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Hóspedes -->
            <Border
                BackgroundColor="{StaticResource HotelCard}"
                Padding="20"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Hóspedes"
                        Style="{StaticResource TituloSecao}" />

                    <Grid
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto,Auto,Auto"
                        RowSpacing="14"
                        ColumnSpacing="10">

                        <!-- Adultos -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Adultos"
                            Style="{StaticResource TextoNormal}" />

                        <Label
                            x:Name="lbl_adultos"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="0"
                            Style="{StaticResource ValorDestacado}"
                            WidthRequest="30" />

                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Text="-"
                            Style="{StaticResource BotaoContador}"
                            Clicked="DiminuirAdultos_Clicked" />

                        <Button
                            Grid.Row="0"
                            Grid.Column="3"
                            Text="+"
                            Style="{StaticResource BotaoContador}"
                            Clicked="AumentarAdultos_Clicked" />

                        <!-- Crianças -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Crianças"
                            Style="{StaticResource TextoNormal}" />

                        <Label
                            x:Name="lbl_criancas"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="0"
                            Style="{StaticResource ValorDestacado}"
                            WidthRequest="30" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="-"
                            Style="{StaticResource BotaoContador}"
                            Clicked="DiminuirCriancas_Clicked" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="3"
                            Text="+"
                            Style="{StaticResource BotaoContador}"
                            Clicked="AumentarCriancas_Clicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Acomodação -->
            <Border
                BackgroundColor="{StaticResource HotelCard}"
                Padding="20"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Escolha sua suíte"
                        Style="{StaticResource TituloSecao}" />

                    <Border
                        BackgroundColor="#E2E8F0"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        Padding="0"
                        Margin="0,4,0,0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Picker
                            x:Name="pck_quarto"
                            ItemDisplayBinding="{Binding Descricao}"
                            TextColor="#0F172A"
                            TitleColor="#64748B"
                            FontFamily="OpenSansRegular"
                            FontSize="15"
                            BackgroundColor="Transparent"
                            HeightRequest="56"
                            MinimumHeightRequest="56"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Margin="8,0" />

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- Período -->
            <Border
                BackgroundColor="{StaticResource HotelCard}"
                Padding="20"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Período da estadia"
                        Style="{StaticResource TituloSecao}" />

                    <Grid
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="100,*"
                        RowSpacing="12"
                        ColumnSpacing="10">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Check-in"
                            Style="{StaticResource TextoNormal}" />

                        <DatePicker
                            x:Name="dtpck_checkin"
                            Grid.Row="0"
                            Grid.Column="1"
                            DateSelected="dtpck_checkin_DateSelected"
                            Format="dd/MM/yyyy"
                            Style="{StaticResource DatePickerHotel}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Check-out"
                            Style="{StaticResource TextoNormal}" />

                        <DatePicker
                            x:Name="dtpck_checkout"
                            Grid.Row="1"
                            Grid.Column="1"
                            Format="dd/MM/yyyy"
                            Style="{StaticResource DatePickerHotel}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <Button
                Text="Calcular diária"
                Clicked="Button_Clicked"
                Style="{StaticResource BotaoPrincipal}"
                Margin="0,5,0,25" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>